{
  "name": "markrun",
  "version": "0.1.0",
  "description": "MARKRUN - a two-player parkrun betting party game built from Mark's real Finsbury parkrun history.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "build": "node tools/build.mjs",
    "ingest": "node --disable-warning=ExperimentalWarning server/import/ingest.mjs",
    "refresh": "node --disable-warning=ExperimentalWarning server/import/refresh.mjs",
    "audit": "node --disable-warning=ExperimentalWarning tools/audit.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"tests/*.test.mjs\"",
    "build:web": "node --disable-warning=ExperimentalWarning tools/build_web.mjs",
    "test:web": "node --disable-warning=ExperimentalWarning tools/web_e2e.mjs",
    "export:web": "node --disable-warning=ExperimentalWarning tools/export_web_data.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0",
    "peer": "1.0.2",
    "peerjs": "1.5.5",
    "three": "0.170.0"
  }
}
