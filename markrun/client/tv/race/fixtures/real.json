r5","atM":447,"broadcastS":13.35},{"type":"lead_change","raceS":86,"from":"r5","to":"r4","atM":476,"broadcastS":13.35},{"type":"overtake","raceS":112,"by":"r2","on":"r1","atM":546,"broadcastS":15.07},{"type":"overtake","raceS":135,"by":"r3","on":"r1","atM":639,"broadcastS":16.59},{"type":"overtake","raceS":146,"by":"r1","on":"r3","atM":686,"broadcastS":17.32},{"type":"overtake","raceS":153,"by":"r3","on":"r1","atM":715,"broadcastS":17.78},{"type":"overtake","raceS":161,"by":"r2","on":"r5","atM":759,"broadcastS":18.31},{"type":"overtake","raceS":211,"by":"r3","on":"r5","atM":963,"broadcastS":21.61},{"type":"overtake","raceS":341,"by":"r1","on":"r5","atM":1522,"broadcastS":30.2},{"type":"hill","raceS":363.88599999999997,"lap":1,"atM":1720,"broadcastS":31.71},{"type":"overtake","raceS":516,"by":"r3","on":"r2","atM":2268,"broadcastS":41.77},{"type":"lap","raceS":558.45,"atM":2500,"order":["r4","r3","r2","r1","r5"],"broadcastS":44.57},{"type":"hill","raceS":963.846,"lap":2,"atM":4220,"broadcastS":71.36},{"type":"final_stretch","raceS":1069.14,"atM":4600,"order":["r4","r3","r2","r1","r5"],"broadcastS":91.33},{"type":"finish","raceS":1160,"who":"r4","place":1,"broadcastS":122.45},{"type":"finish","raceS":1161,"who":"r3","place":2,"broadcastS":122.8},{"type":"finish","raceS":1186,"who":"r2","place":3,"broadcastS":131.36},{"type":"finish","raceS":1215,"who":"r1","place":4,"broadcastS":141.29},{"type":"finish","raceS":1221,"who":"r5","place":5,"broadcastS":143.35}],"finishOrder":["r4","r3","r2","r1","r5"],"summary":{"winningMarginS":1,"spreadS":61,"leadChanges":2,"overtakes":14,"lateLeadChange":false},"commentary":[{"broadcastS":0.4,"text":"And we're off! Elbows out, dignity left at the start line!","speaker":"jeff","priority":1},{"broadcastS":6.5,"text":"Steady start. Very British.","speaker":"pam","priority":3},{"broadcastS":13.35,"text":"Here's Nigel Two-Laps, flying! Up into first place!","speaker":"jeff","priority":2,"eventRef":{"type":"lead_change","raceS":86}},{"broadcastS":18.1,"text":"Someone has been saving their legs.","speaker":"pam","priority":3,"eventRef":{"type":"lead_change","raceS":86}},{"broadcastS":22.86,"text":"The Spare Rib reels in The Arsenal Arrow!","speaker":"jeff","priority":3,"eventRef":{"type":"overtake","raceS":211}},{"broadcastS":31.71,"text":"First ascent of the Hill! Arms pumping!","speaker":"jeff","priority":2,"eventRef":{"type":"hill","raceS":363.88599999999997}},{"broadcastS":36.71,"text":"I walked this bit once. Nobody saw.","speaker":"pam","priority":3,"eventRef":{"type":"hill","raceS":363.88599999999997}},{"broadcastS":44.57,"text":"Lap one in the bag! Nigel Two-Laps in front, The Spare Rib second!","speaker":"jeff","priority":2,"eventRef":{"type":"lap","raceS":558.45}},{"broadcastS":51.32,"text":"Same again, please. Only slower.","speaker":"pam","priority":3,"eventRef":{"type":"lap","raceS":558.45}},{"broadcastS":56.07,"text":"One of the marshals is eating a sausage roll. Respect.","speaker":"pam","priority":3},{"broadcastS":65.2,"text":"You can feel the tension! Or is that my breakfast?","speaker":"jeff","priority":3},{"broadcastS":71.36,"text":"The Hill one more time! Last climb! Everything they've got!","speaker":"jeff","priority":2,"eventRef":{"type":"hill","raceS":963.846}},{"broadcastS":76.86,"text":"Arms everywhere. Form nowhere.","speaker":"pam","priority":3,"eventRef":{"type":"hill","raceS":963.846}},{"broadcastS":81.67,"text":"One of you on that sofa knew Nigel ran 155 kilometres in the previous month. Just saying.","speaker":"pam","priority":3},{"broadcastS":91.33,"text":"Into the final straight! Nigel Two-Laps! The Spare Rib! Everything left!","speaker":"jeff","priority":1,"eventRef":{"type":"final_stretch","raceS":1069.14}},{"broadcastS":98.33,"text":"Nigel Two-Laps with daylight! The Spare Rib giving everything!","speaker":"jeff","priority":2},{"broadcastS":105.83,"text":"Can't split them! Nigel Two-Laps and The Spare Rib together!","speaker":"jeff","priority":2},{"broadcastS":113.33,"text":"Nigel Two-Laps still holds on! The Spare Rib is 10 metres back!","speaker":"jeff","priority":2},{"broadcastS":122.45,"text":"Lean! Lean! Nigel Two-Laps leans and takes it from The Spare Rib!","speaker":"jeff","priority":1,"eventRef":{"type":"finish","raceS":1160}},{"broadcastS":128.95,"text":"I'd want to see the replay.","speaker":"pam","priority":2,"eventRef":{"type":"finish","raceS":1160}},{"broadcastS":143.35,"text":"Last but not least, it's The Arsenal Arrow!","speaker":"jeff","priority":2,"eventRef":{"type":"finish","raceS":1221}},{"broadcastS":148.1,"text":"Somebody had to.","speaker":"pam","priority":3,"eventRef":{"type":"finish","raceS":1221}}]}}