:[{"type":"overtake","raceS":20,"by":"r4","on":"r5","atM":79,"broadcastS":5},{"type":"diversion","who":"r5","lap":1,"raceS":85.808,"endRaceS":204.278,"fromM":371,"toM":827,"broadcastS":13.06,"endBroadcastS":20.25},{"type":"overtake","raceS":109,"by":"r4","on":"r3","atM":493,"broadcastS":14.47},{"type":"overtake","raceS":316,"by":"r2","on":"r1","atM":1417,"broadcastS":27.02},{"type":"lead_change","raceS":316,"from":"r1","to":"r2","atM":1444,"broadcastS":27.02},{"type":"overtake","raceS":352,"by":"r1","on":"r2","atM":1574,"broadcastS":29.2},{"type":"lead_change","raceS":352,"from":"r2","to":"r1","atM":1600,"broadcastS":29.2},{"type":"hill","raceS":389.712,"lap":1,"atM":1720,"broadcastS":31.49},{"type":"breakaway","raceS":538,"who":"r1","gapM":60,"atM":2279,"broadcastS":40.48},{"type":"lap","raceS":592.31,"atM":2500,"order":["r1","r2","r4","r3","r5"],"broadcastS":43.77},{"type":"overtake","raceS":613,"by":"r3","on":"r4","atM":2415,"broadcastS":45.02},{"type":"diversion","who":"r5","lap":2,"raceS":749.3979999999999,"endRaceS":872.032,"fromM":2931,"toM":3370,"broadcastS":53.29,"endBroadcastS":60.73},{"type":"overtake","raceS":930,"by":"r5","on":"r4","atM":3586,"broadcastS":64.24},{"type":"overtake","raceS":984,"by":"r4","on":"r5","atM":3786,"broadcastS":67.52},{"type":"overtake","raceS":999,"by":"r5","on":"r4","atM":3843,"broadcastS":68.43},{"type":"overtake","raceS":1018,"by":"r4","on":"r5","atM":3912,"broadcastS":69.58},{"type":"hill","raceS":1037.704,"lap":2,"atM":4220,"broadcastS":70.77},{"type":"overtake","raceS":1060,"by":"r5","on":"r4","atM":4078,"broadcastS":72.12},{"type":"final_stretch","raceS":1160.51,"atM":4600,"order":["r1","r2","r3","r5","r4"],"broadcastS":91.14},{"type":"finish","raceS":1257,"who":"r1","place":1,"broadcastS":122.56},{"type":"finish","raceS":1284,"who":"r2","place":2,"broadcastS":131.35},{"type":"finish","raceS":1299,"who":"r3","place":3,"broadcastS":136.24},{"type":"finish","raceS":1311,"who":"r5","place":4,"broadcastS":140.15},{"type":"finish","raceS":1320,"who":"r4","place":5,"broadcastS":143.08}],"finishOrder":["r1","r2","r3","r5","r4"],"summary":{"winningMarginS":27,"spreadS":63,"leadChanges":2,"overtakes":10,"lateLeadChange":false},"commentary":[{"broadcastS":0.4,"text":"Go go go! We are racing at Finsbury Park!","speaker":"jeff","priority":1},{"broadcastS":6,"text":"Plenty of watches being fiddled with. None of them will help.","speaker":"pam","priority":3},{"broadcastS":13.06,"text":"The Highbury Hammer has left the course! Straight towards the candyfloss!","speaker":"jeff","priority":1,"eventRef":{"type":"diversion","raceS":85.808}},{"broadcastS":20.25,"text":"The Highbury Hammer is back on the course! Smelling faintly of doughnuts!","speaker":"jeff","priority":1,"eventRef":{"type":"diversion","raceS":85.808}},{"broadcastS":26.55,"text":"There goes his race plan. Into a coconut shy.","speaker":"pam","priority":2,"eventRef":{"type":"diversion","raceS":85.808}},{"broadcastS":31.7,"text":"They're swapping the lead like a hot potato!","speaker":"jeff","priority":2,"eventRef":{"type":"lead_change","raceS":352}},{"broadcastS":36.52,"text":"And this is the one who ran 66 kilometres in the previous month! Make it make sense!","speaker":"pam","priority":2,"eventRef":{"type":"lead_change","raceS":316}},{"broadcastS":44.77,"text":"Lap one complete! It's Captain Calves! Then The Long Socks! Then chaos!","speaker":"jeff","priority":2,"eventRef":{"type":"lap","raceS":592.31}},{"broadcastS":53.29,"text":"The Highbury Hammer is off to the fairground AGAIN!","speaker":"jeff","priority":2,"eventRef":{"type":"diversion","raceS":749.3979999999999}},{"broadcastS":60.73,"text":"And The Highbury Hammer rejoins the course, clutching a goldfish!","speaker":"jeff","priority":2,"eventRef":{"type":"diversion","raceS":749.3979999999999}},{"broadcastS":66.28,"text":"Second helping of candyfloss. Of course.","speaker":"pam","priority":2,"eventRef":{"type":"diversion","raceS":749.3979999999999}},{"broadcastS":71.02,"text":"The Hill, lap two! The legs are screaming! I'm screaming!","speaker":"jeff","priority":2,"eventRef":{"type":"hill","raceS":1037.704}},{"broadcastS":76.52,"text":"They hate this bit. I love this bit.","speaker":"pam","priority":3,"eventRef":{"type":"hill","raceS":1037.704}},{"broadcastS":81.29,"text":"What a spectacle! What a park! What a morning!","speaker":"jeff","priority":3},{"broadcastS":91.14,"text":"Into the final stretch! Captain Calves leads! Can The Long Socks catch them?","speaker":"jeff","priority":1,"eventRef":{"type":"final_stretch","raceS":1160.51}},{"broadcastS":98.14,"text":"Captain Calves has time to stop for a coffee! Don't, though!","speaker":"jeff","priority":2},{"broadcastS":105.14,"text":"The timekeeper is pressing that button like it owes him money.","speaker":"pam","priority":3},{"broadcastS":114.14,"text":"What a sport! What a sport this is!","speaker":"jeff","priority":3},{"broadcastS":122.56,"text":"First home, Captain Calves! Take a bow!","speaker":"jeff","priority":1,"eventRef":{"type":"finish","raceS":1257}},{"broadcastS":131.35,"text":"Second for The Long Socks! Not bad at all!","speaker":"jeff","priority":3,"eventRef":{"type":"finish","raceS":1284}},{"broadcastS":143.08,"text":"The Overtaking Lane finishes! Fifth! Of five! Proudly!","speaker":"jeff","priority":2,"eventRef":{"type":"finish","raceS":1320}},{"broadcastS":147.83,"text":"He was saving himself for next week.","speaker":"pam","priority":3,"eventRef":{"type":"finish","raceS":1320}}]}}