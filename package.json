{
  "name": "parking-panic-st-albans",
  "version": "1.0.0",
  "description": "PARKING PANIC: ST ALBANS EDITION - musical chairs, but with cars and parking spaces.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=dist/game.js",
    "dev": "esbuild src/main.js --bundle --format=iife --target=es2019 --outfile=dist/game.js --servedir=. --watch",
    "serve": "esbuild --servedir=. --serve=8080",
    "test": "node tests/sim.test.mjs",
    "test:browser": "node tests/browser.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "three": "^0.170.0"
  }
}
